# Copy to .env and fill in. .env is ignored by Git. Never commit real values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canteen_db
DB_USER=canteen_app
DB_PASSWORD=replace-with-canteen-app-password
# Used only by database/setup.* and database maintenance, never by the API.
DB_ADMIN_USER=canteen_admin
DB_ADMIN_PASSWORD=replace-with-canteen-admin-password
# Set this to a separate password when provisioning the reporting login.
DB_READONLY_PASSWORD=replace-with-canteen-readonly-password
# Avoid double quotes in passwords (Windows PowerShell mangles them).
# JWT_SECRET: at least 32 random characters
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
